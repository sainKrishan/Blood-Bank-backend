# Database connection (Railway MySQL)
DB_HOST=your_railway_host_here
DB_USER=your_railway_user_here
DB_PASSWORD=your_railway_password_here
DB_NAME=your_railway_db_name_here
DB_PORT=3306

# JWT secret - use a long random string in production
JWT_SECRET=your_strong_jwt_secret_here

# Comma-separated list of allowed frontend origins (no spaces)
# Example: https://your-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Server port (Render sets this automatically)
PORT=5000
